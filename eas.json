{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://devapi.criconic.com/",
        "EXPO_PUBLIC_WEB_URL": "https://dev.criconic.com"
      }
    },
    "preview": {
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_API_URL": "https://devapi.criconic.com/",
        "EXPO_PUBLIC_WEB_URL": "https://dev.criconic.com"
      }
    },
    "production": {
      "autoIncrement": true,
      "env": {
        "EXPO_PUBLIC_API_URL": "https://api.criconic.com/",
        "EXPO_PUBLIC_WEB_URL": "https://criconic.com"
      }
    }
  },
  "submit": {
    "production": {
      "android": {
        "track": "production"
      }
    }
  }
}
